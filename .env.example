# Supabase Configuration
# Replace these with your project values from https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Application URL (Update to your Vercel production domain)
NEXT_PUBLIC_APP_URL=https://your-owner-app.vercel.app

# Demo Mode Flag
# Set to "false" once real Supabase database schema is connected
# Set to "true" to run with built-in interactive demo mock data
NEXT_PUBLIC_DEMO_MODE=true
